{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kept",
  "compatibility_date": "2026-09-11",
  // The journey lives on one route, so any path that is not a file falls back
  // to index.html rather than a 404.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "kept.doan-labs.com", "custom_domain": true }]
}
